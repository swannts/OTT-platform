# Production deployment inputs. Copy to a private environment file for local
# validation or inject these values from the deployment secret manager.
APP_KEY=
APP_URL=https://api.example.com
ADMIN_UI_URL=https://admin.example.com
FRONTEND_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api
BACKEND_PORT=8000
ADMIN_PORT=3032
FRONTEND_PORT=3000
DB_DATABASE=swann
DB_USERNAME=ott_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DEMO_SEED_PASSWORD=
# Keep false for normal development; true allows catalog fixtures to replace shared content.
DEMO_CATALOG_REPLACE=false
RABBITMQ_USER=ott_worker
RABBITMQ_PASS=
MEILI_MASTER_KEY=
ADMIN_UI_IMAGE=
BACKEND_IMAGE=
FRONTEND_IMAGE=
WORKER_IMAGE=
MYSQL_IMAGE=
REDIS_IMAGE=
RABBITMQ_IMAGE=
MEILISEARCH_IMAGE=
