# ==============================================================================
# Swann OTT Production Environment Configuration (.env.production.example)
# Copy this file to a protected file outside the repository and inject real
# secrets from the deployment secret manager. Replace every blank/placeholder.
# Validate with both docker-compose.yml and docker-compose.production.yml.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
ADMIN_UI_URL=https://admin.example.com
FRONTEND_URL=https://watch.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://watch.example.com

# Generate a unique value for this deployment; never reuse or commit it.
APP_KEY=

# ------------------------------------------------------------------------------
# Next.js Frontend Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_NAME="Swann OTT"
NEXT_PUBLIC_API_URL=https://api.example.com/api
INTERNAL_API_URL=http://backend:8000/api

# ------------------------------------------------------------------------------
# Laravel Backend Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
ADMIN_PORT=3032

# Publish immutable image references (prefer registry digests) before deploy.
ADMIN_UI_IMAGE=
BACKEND_IMAGE=
FRONTEND_IMAGE=
WORKER_IMAGE=
MYSQL_IMAGE=
REDIS_IMAGE=
RABBITMQ_IMAGE=
MEILISEARCH_IMAGE=

# ------------------------------------------------------------------------------
# Database (MySQL 8.0)
# ------------------------------------------------------------------------------
DB_DATABASE=swann
DB_USERNAME=ott_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ------------------------------------------------------------------------------
# Message Queue (RabbitMQ 3.13)
# ------------------------------------------------------------------------------
RABBITMQ_USER=ott_service
RABBITMQ_PASS=

# ------------------------------------------------------------------------------
# Search Engine (Meilisearch)
# ------------------------------------------------------------------------------
MEILI_MASTER_KEY=

# Run scripts/production-backup.sh from the deployment host with these values
# supplied through its protected scheduler environment, not the app container.
# BACKUP_DIR=/mnt/offsite/ott
# BACKUP_AGE_RECIPIENT=age1...
