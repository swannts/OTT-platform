# ==============================================================================
# OTT Platform Production Environment Configuration (.env.production.example)
# Copy this file to a protected file outside the repository and inject real
# secrets from the deployment secret manager. Replace every blank/placeholder.
# Validate with both compose.yaml and compose.production.yaml.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_NAME="OTT Platform"
APP_RELEASE_ID=
APP_RELEASED_AT=
APP_URL=https://api.example.com
ADMIN_UI_URL=https://admin.example.com
FRONTEND_URL=https://watch.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://watch.example.com
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="NOOR Islamic Cinema"
# Set only to edge CIDRs whose proxy overwrites this header after removing any
# client-supplied value. Keep blank until the production edge is verified.
PLAYBACK_GEO_COUNTRY_HEADER=CF-IPCountry
PLAYBACK_GEO_TRUSTED_PROXY_CIDRS=

# Generate a unique value for this deployment; never reuse or commit it.
APP_KEY=

# ------------------------------------------------------------------------------
# Next.js Frontend Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_NAME="NOOR Islamic Cinema"
NEXT_PUBLIC_API_URL=https://api.example.com/api
INTERNAL_API_URL=http://api:8000/api

# ------------------------------------------------------------------------------
# Laravel Backend Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
ADMIN_PORT=3032

# Publish immutable image references (prefer registry digests) before deploy.
ADMIN_IMAGE=
API_IMAGE=
WEB_IMAGE=
WORKER_IMAGE=
MYSQL_IMAGE=
REDIS_IMAGE=
RABBITMQ_IMAGE=
MEILISEARCH_IMAGE=
# Deprecated image-variable aliases remain supported during deployment migration.
ADMIN_UI_IMAGE=
BACKEND_IMAGE=
FRONTEND_IMAGE=

# ------------------------------------------------------------------------------
# Database (MySQL 8.0)
# ------------------------------------------------------------------------------
DB_DATABASE=swann
DB_USERNAME=ott_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ------------------------------------------------------------------------------
# Message Queue (RabbitMQ 3.13)
# ------------------------------------------------------------------------------
RABBITMQ_USER=ott_service
RABBITMQ_PASS=
RABBITMQ_URL=
DB_DSN=

# ------------------------------------------------------------------------------
# Search Engine (Meilisearch)
# ------------------------------------------------------------------------------
MEILI_MASTER_KEY=

# Laravel-managed backups use a separate private S3-compatible bucket. Provide
# either a scoped access-key pair or workload identity in the deployment host.
BACKUP_DISKS=backup-s3
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAX_STORAGE_MB=500000
BACKUP_NOTIFICATION_EMAIL=
OPERATIONS_ALERT_EMAIL=
OPERATIONS_ALERT_MINIMUM_SEVERITY=high
AWS_BACKUP_BUCKET=
AWS_BACKUP_REGION=
AWS_BACKUP_ACCESS_KEY_ID=
AWS_BACKUP_SECRET_ACCESS_KEY=
AWS_BACKUP_ENDPOINT=
AWS_BACKUP_PREFIX=ott-prod-backups

# Run scripts/production-backup.sh from the deployment host with these values
# supplied through its protected scheduler environment, not the app container.
# BACKUP_DIR=/mnt/offsite/ott
# BACKUP_AGE_RECIPIENT=age1...
